# Environment variables for the application

# NEXT_APP_URL: The base path for the application. This is the prefix for all routes in the application.
NEXT_APP_URL=/gui

# NEXT_PUBLIC_ISTSOS4_URL: The URL for the ISTSOS4 service. This is used to connect to the ISTSOS4 API for time series data.
NEXT_PUBLIC_ISTSOS4_URL=https://hydromet.supsi.ch/tsdb/v1.1

# NEXT_PUBLIC_MAP_CENTER: The default center coordinates for the map. This is used to set the initial view of the map.
NEXT_PUBLIC_MAP_CENTER=45.8693, 8.9770

# NEXT_PUBLIC_MAP_ZOOM: The default zoom level for the map. This is used to set the initial zoom level of the map.
NEXT_PUBLIC_MAP_ZOOM=10

# NEXT_PUBLIC_MAP_DEFAULT_BASEMAP: The default basemap for the map. This is used to set the initial basemap of the map.
NEXT_PUBLIC_MAP_DEFAULT_BASEMAP=pixelColor

# NEXT_PUBLIC_VERSIONING_ENABLED: Enables snapshot, history and version comparison in the GUI.
# false (default) — Live backend data only; versioning controls and routes are disabled.
# true            — Enables historical reads. Requires versioning support on the backend.
# This setting does not change backend version storage or the SaQC draft audit log.
NEXT_PUBLIC_VERSIONING_ENABLED=true
SAQC_SERVICE_URL=http://saqc:8000
COMPOSE_PROFILES=saqc

# Decode valid resultQuality bitmasks. false shows only catalog descriptions or Unknown.
RESULT_QUALITY_BITMASK_ENABLED=true

# Legacy quality catalog (JSON). Empty or unset disables descriptions; there is no fallback.
# JSON uses double-quoted dotenv syntax: escape JSON quotes; use $$ for a literal dollar sign.
RESULT_QUALITY_CODES="[{\"code\":100,\"description\":{\"en\":\"Data loaded into the database (correct format)\",\"it\":\"Dato caricato in banca dati (formato corretto)\"}},{\"code\":101,\"description\":{\"en\":\"Manual entry for the 2025 rain-gauge overwrite issue\",\"it\":\"Inserimento manuale per problema pluviometri 2025\"}},{\"code\":110,\"description\":{\"en\":\"Missing data\",\"it\":\"Dato mancante\"}},{\"code\":120,\"description\":{\"en\":\"Value cannot be converted\",\"it\":\"Valore non convertibile\"}},{\"code\":132,\"description\":{\"en\":\"Raw external source\",\"it\":\"Dato grezzo da fonte esterna\"}},{\"code\":208,\"description\":{\"en\":\"Reasonable value for the observed property\",\"it\":\"Valore ragionevole per la proprieta osservata\"}},{\"code\":210,\"description\":{\"en\":\"Plausible sensor value within the minimum and maximum thresholds for the observed property and specific station\",\"it\":\"Valore sensato per il sensore all'interno di soglie minime e massime per la proprieta osservata e la specifica stazione\"}},{\"code\":220,\"description\":{\"en\":\"Plausibility check based on data from the last 24–48 hours\",\"it\":\"Controllo di plausibilità sulla base dei dati delle ultime 24/48 ore\"}},{\"code\":230,\"description\":{\"en\":\"Comparison with nearby sensors or radar data and reliability verification\",\"it\":\"Confronto con i dati di altri sensori vicini o dati radar e verifica di affidabilità\"}},{\"code\":310,\"description\":{\"en\":\"Data manually reviewed and considered incorrect\",\"it\":\"Dato analizzato manualmente e ritenuto NON corretto\"}},{\"code\":312,\"description\":{\"en\":\"Data derived through digitization and considered incorrect\",\"it\":\"Dato calcolato da un processo di digitalizzazione e ritenuto SBAGLIATO\"}},{\"code\":313,\"description\":{\"en\":\"Data derived through semi-automatic interpolation from a time resolution coarser than 10 minutes and considered incorrect\",\"it\":\"Dato calcolato da un processo di interpolazione semi-automatica, partendo da una scala temporale superiore a 10 min e ritenuto SBAGLIATO\"}},{\"code\":320,\"description\":{\"en\":\"Data manually reviewed and considered correct after manual correction\",\"it\":\"Dato analizzato manualmente e ritenuto corretto grazie ad una correzione manuale\"}},{\"code\":321,\"description\":{\"en\":\"Partially corrected data\",\"it\":\"Dato parzialmente corretto\"}},{\"code\":322,\"description\":{\"en\":\"Data derived through digitization and considered valid after manual correction or completion\",\"it\":\"Dato calcolato da un processo di digitalizzazione e ritenuto valido grazie ad una correzione o completamento manuale\"}},{\"code\":323,\"description\":{\"en\":\"Data derived through semi-automatic interpolation from a time resolution coarser than 10 minutes and considered valid only after manual correction\",\"it\":\"Dato calcolato da un processo di interpolazione semi-automatica, partendo da una scala temporale superiore a 10 min. Ritenuto valido solo grazie ad una correzione manuale\"}},{\"code\":330,\"description\":{\"en\":\"Data manually reviewed and considered correct without any correction\",\"it\":\"Dato analizzato manualmente e ritenuto corretto senza alcuna correzione\"}},{\"code\":332,\"description\":{\"en\":\"Data derived through digitization and considered valid and consistent with daily data without any correction\",\"it\":\"Dato calcolato da un processo di digitalizzazione e ritenuto valido e coerente con i dati giornalieri senza alcuna correzione\"}},{\"code\":333,\"description\":{\"en\":\"Data derived through semi-automatic interpolation from a time resolution coarser than 10 minutes and consistent with daily data without any correction\",\"it\":\"Dato calcolato da un processo di interpolazione semi-automatica, partendo da una scala temporale superiore a 10 min. Coerente con i dati giornalieri senza alcuna correzione\"}}]"
